# Copy to .env and fill in. NEVER commit .env.

# Public domain served by Caddy (must point to this host)
KFIRE_DOMAIN=kfire.example.org

# PostgreSQL password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# JWT signing secret (generate: openssl rand -hex 32)
KFIRE_JWT_SECRET=

# AES-256-GCM master key for OAuth tokens at rest (generate: openssl rand -base64 32)
KFIRE_MASTER_KEY=

# --- Connectors (optional) ---
# Steam Web API key - enables "Link Steam" (https://steamcommunity.com/dev/apikey)
KFIRE_STEAM_API_KEY=

# Battle.net OAuth2 - enables "Link Battle.net" (https://develop.battle.net)
# Set the app's redirect URL to: https://<your-domain>/api/v1/connect/battlenet/callback
KFIRE_BATTLENET_CLIENT_ID=
KFIRE_BATTLENET_CLIENT_SECRET=

# PUBG Game Data Service key (free, from developer.pubg.com).
# Empty disables PUBG entirely: no history, and the account page hides its card.
KFIRE_PUBG_API_KEY=

# PlayStation: optional first-boot seed for the instance's bot NPSSO. After
# that, an admin pastes a new one in Admin > PlayStation (sealed in the
# database). Empty = no bot until an admin sets one; the card stays hidden.
KFIRE_PSN_NPSSO=
# How often PlayStation presence is polled (default 1m, minimum 30s).
# KFIRE_PSN_POLL_INTERVAL=1m

# Nintendo Switch: an OAuth client registered on https://nxapi-auth.fancy.org.uk
# (scopes ca:gf ca:er ca:dr, "Shared secret"), used by the nxapi sidecar for the
# Nintendo Switch Online app protocol. Empty = Nintendo connector off.
KFIRE_NXAPI_CLIENT_ID=
KFIRE_NXAPI_SHARED_SECRET=
# Optional first-boot seed for the bot's Nintendo session token; afterwards an
# admin logs the bot in from Admin > Nintendo.
KFIRE_NINTENDO_SESSION_TOKEN=
# KFIRE_NINTENDO_POLL_INTERVAL=1m
# Forgotten password by email (Brevo). Leave empty to disable.
KFIRE_BREVO_API_KEY=
KFIRE_MAIL_FROM=
KFIRE_MAIL_FROM_NAME=
