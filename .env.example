# Copy to .env and fill in. NEVER commit .env.

# Public domain served by Caddy (must point to this host)
KFIRE_DOMAIN=kfire.example.org

# PostgreSQL password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# JWT signing secret (generate: openssl rand -hex 32)
KFIRE_JWT_SECRET=

# AES-256-GCM master key for OAuth tokens at rest (generate: openssl rand -base64 32)
KFIRE_MASTER_KEY=

# --- Connectors (optional) ---
# Steam Web API key — enables "Link Steam" (https://steamcommunity.com/dev/apikey)
KFIRE_STEAM_API_KEY=
